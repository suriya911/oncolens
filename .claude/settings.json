{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pytest)",
      "Bash(pytest *)",
      "Bash(ruff *)",
      "Bash(mypy *)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(nvidia-smi)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(python scripts/*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(~/.kaggle/**)",
      "Read(~/.ssh/**)",
      "Read(~/.netrc)",
      "Read(~/.cache/huggingface/token)",
      "Bash(sudo *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(docker *)",
      "Bash(kaggle *)",
      "Bash(vercel *)",
      "Bash(gh secret *)"
    ]
  }
}
